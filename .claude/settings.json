{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_LINT_ON_EDIT": "1",
    "CLAUDE_VERIFY_BUILD": "0",
    "CLAUDE_VERIFY_MAX_ATTEMPTS": "3"
  },
  "permissions": {
    "allow": [
      "Bash(bash .claude/hooks/*)",
      "Bash(bash .claude/skills/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(~/secrets/**)",
      "Read(./**/appsettings.Development.local.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-file.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
